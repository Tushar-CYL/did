# AccountSignal — environment template.
# Copy this file to ".env" and fill in the values. NEVER commit ".env".

# EY internal LLM (EYQ Incubator) — OpenAI-compatible endpoint
EYQ_INCUBATOR_ENDPOINT=https://eyq-incubator.america.fabric.ey.com/eyq/us/api
EYQ_INCUBATOR_KEY=your-key-here
EYQ_MODEL=gpt-5.2

# Optional tuning
ACCOUNTSIGNAL_LOOKBACK_DAYS=30
ACCOUNTSIGNAL_REQUEST_TIMEOUT=30

# Apify API token (free account) — enables the Apify hiring fallback.
APIFY_TOKEN=your-apify-token-here
