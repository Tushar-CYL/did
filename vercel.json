{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "installCommand": "npm --prefix webapp ci --no-audit --no-fund",
  "buildCommand": "npm --prefix webapp run build",
  "outputDirectory": "webapp/out",
  "headers": [
    {
      "source": "/data.json",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store, no-cache, must-revalidate, max-age=0"
        }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [{ "key": "X-Content-Type-Options", "value": "nosniff" }]
    }
  ]
}
